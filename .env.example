# Local compose Postgres is published on 55432 to avoid colliding with a
# host Postgres on 5432.
MEMORY_DATABASE_URL=postgres://memory:memory@127.0.0.1:55432/memory?sslmode=disable

# Brew/local default is localhost only. Binding 0.0.0.0 or :8741 is opt-in
# (used in-cluster).
MEMORY_LISTEN=127.0.0.1:8741
MEMORY_URL=http://127.0.0.1:8741

# Admin or harness bearer token (set after `memory token create`).
MEMORY_TOKEN=

# Optional override of the one-way MEMORY.md projection directory.
# Default: ~/.local/share/harness-memory/projection
# MEMORY_PROJECTION_DIR=

# Integration tests skip unless this is set. CI always sets it.
# Local compose:
MEMORY_TEST_DATABASE_URL=postgres://memory:memory@127.0.0.1:55432/memory?sslmode=disable
